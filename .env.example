ANTHROPIC_API_KEY=
POLYTONE_MODEL=claude-sonnet-5-5
# "anthropic" (default when key present) or "mock" (offline, deterministic)
POLYTONE_LLM=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=polytone-local
POLYTONE_API_PORT=8765
POLYTONE_DATA_DIR=./data
POLYTONE_WATCH_DIR=./data/inbox
# Gmail outbound MCP
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./data/gmail_token.json
# Wispr Flow
WISPR_API_KEY=
WISPR_WS_URL=
# Embeddings: "qwen" (Qwen/Qwen3-Embedding-0.6B via sentence-transformers) or "none"
POLYTONE_EMBEDDINGS=qwen
# Your own addresses (comma-separated) — the watcher keeps only .mbox messages From: these
POLYTONE_USER_EMAILS=
# Wispr Flow local history fallback (macOS): 1 = read ~/Library/Application Support/Wispr Flow, 0 = off
POLYTONE_WISPR_LOCAL=1
# Watch POLYTONE_WATCH_DIR continuously while the backend runs (0 = only on "Run")
POLYTONE_WATCHER=1
